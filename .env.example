# This file documents controlled research reproduction only.
# Copy values into an ignored environment file; never commit credentials.
# The acknowledgement must also be exported in the shell because the tripwire
# is evaluated before dotenv loads any file.
MCP_REFERENCE_ACKNOWLEDGEMENT=unsupported-reference-only
BACKEND_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mcp_server_reference
DB_USER=replace-with-dedicated-non-superuser
DB_PASSWORD=replace-with-a-random-research-only-password
JWT_SECRET=replace-with-an-independent-random-value-of-at-least-32-bytes
REFERENCE_ADMIN_PASSWORD=replace-with-a-random-research-only-value-of-at-least-16-characters
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
REACT_APP_API_BASE=http://127.0.0.1:3001/api
